# Copy to .env.local and fill in once the Supabase project exists.
# Project Settings -> API in the Supabase dashboard.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Telephony provider override (optional). Defaults to system_config in DB.
# TELEPHONY_PROVIDER=manual

# Cron route auth (app/api/cron/reconcile) — set once that route exists.
# CRON_SECRET=
